# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Preferred variable for frontend origin
CORS_FRONTEND_ORIGIN=http://localhost:3000
# Backwards compatibility (will be used if CORS_FRONTEND_ORIGIN is not set)
FRONTEND_URL=http://localhost:3000

# Database
# e.g. postgres://user:password@localhost:5432/storychain
DATABASE_URL=

# Postgres SSL mode (optional): require | require-verify
# PGSSLMODE=require

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# OpenAI (optional for AI features)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Pooling (optional)
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONN_TIMEOUT_MS=10000
