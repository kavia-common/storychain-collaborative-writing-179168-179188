# Server
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/storychain
PGSSLMODE= # leave empty or set to 'require' or 'require-verify'
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=10000

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
