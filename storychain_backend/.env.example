# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=
# Optional: set to 'require' or 'require-verify' if your provider mandates SSL
# PGSSLMODE=require

# Optional pool tuning
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONN_TIMEOUT_MS=10000

# Auth
JWT_SECRET=
TOKEN_EXPIRES_IN=1d
COOKIE_SECRET=

# CORS
# Frontend origin allowed to call this backend (e.g., http://localhost:3000)
CORS_FRONTEND_ORIGIN=

# AI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.7
