# StoryChain Backend (.env.example)

# Server
PORT=3001
HOST=0.0.0.0

# CORS - set to your frontend URL (e.g., http://localhost:3000)
# Note: app currently reads FRONTEND_URL; keep this in sync with README.
CORS_FRONTEND_ORIGIN=http://localhost:3000
# Backward-compat (used by current code). Prefer setting both for now.
FRONTEND_URL=http://localhost:3000

# Database
# PostgreSQL connection string. Example for local docker/postgres:
# postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storychain

# JWT
# IMPORTANT: Use a strong secret in production.
JWT_SECRET=please-change-me-to-a-strong-secret
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# OpenAI (Optional) - if not set, backend uses local fallback behavior
# OPENAI_BASE_URL defaults to https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Default model if using OpenAI compatible API
OPENAI_MODEL=gpt-4o-mini

# Postgres SSL (Optional)
# Set to "require" (or "require-verify") if your DB requires SSL.
# PGSSLMODE=require
